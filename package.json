{
  "name": "castingcompass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "CASTINGCOMPASS_CLOUDFLARE_BUILD=1 NEXT_PUBLIC_PHOTO_UPLOADS=false NEXT_PUBLIC_API_URL= npm run build",
    "deploy:cloudflare": "node -e \"throw new Error('Safety-floor deployment requires the current reviewed release wrapper')\"",
    "release:cloudflare": "node -e \"throw new Error('Safety-floor deployment requires the current reviewed release wrapper')\"",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:cloudflare && node --test tests/*.test.mjs",
    "test:mobile": "playwright test tests/mobile-viewport.spec.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "data:refresh": "python3 scripts/generate_snapshot.py",
    "api:test": "python3 -m pytest services/api/tests -q"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "5.24.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.45",
    "vite": "8.1.5",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.5",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "sharp": "0.35.3"
  },
  "type": "module"
}
