{
  "schemaVersion": 2,
  "api": {
    "compatibilityVersion": "1",
    "header": "X-CastingCompass-API-Version",
    "requestHeaderRequired": false,
    "unsupportedStatus": 400,
    "unversionedFirstPartyWebAccepted": true
  },
  "authentication": {
    "currentWebMode": "secure_host_cookie",
    "credentialsInLocalStorageAllowed": false,
    "native": {
      "serverBoundary": "implemented_disabled_by_default",
      "releaseMode": "authorization_code_pkce",
      "publicClient": true,
      "clientSecretAllowed": false,
      "exactClientAndRedirectRequired": true,
      "allowedRedirectProtocols": [
        "https:",
        "castingcompass:"
      ],
      "authorizationBrowser": "system_browser_required",
      "codeChallengeMethod": "S256",
      "authorizationCodeSeconds": 300,
      "accessTokenSeconds": 600,
      "refreshTokenSeconds": 2592000,
      "refreshTokenRotationRequired": true,
      "refreshTokenReuseAction": "revoke_family",
      "serverRevocationRequired": true,
      "tokenStorage": "ios_keychain_only",
      "scopes": [
        "profile:read",
        "trips:write"
      ],
      "environment": {
        "enabled": "NATIVE_OAUTH_ENABLED",
        "clientId": "NATIVE_OAUTH_CLIENT_ID",
        "redirectUri": "NATIVE_OAUTH_REDIRECT_URI"
      }
    }
  },
  "coverage": {
    "chromiumProjects": [
      "iphone-se",
      "iphone-13",
      "pixel-7"
    ],
    "webkitProjects": [
      "webkit-iphone-13"
    ],
    "offlineSpec": "tests/mobile-viewport.spec.ts",
    "safeAreaSelectors": [
      ".topbar",
      ".detail-sheet",
      ".respect-modal-layer",
      ".account-modal-layer",
      ".profile-trip-editor-layer",
      ".trip-modal-layer",
      ".active-trip-banner"
    ]
  },
  "sharedContracts": [
    "contracts/native-trip-client.schema.json",
    "contracts/model-run.schema.json",
    "contracts/observation.schema.json",
    "contracts/opportunity.schema.json",
    "contracts/taxa.schema.json"
  ],
  "nativeTripClientPolicy": "security/native-trip-client-policy.json",
  "productionReadiness": false
}
