      "cloud_cover_fraction",
      "pressure_hpa",
      "pressure_trend_hpa_3h",
      "moon_illumination_fraction",
      "expected_access_pressure_fraction",
      "casting_bearing_sin",
      "casting_bearing_cos",
      "forecast_lead_hours",
      "tide_source_age_hours",
      "weather_source_age_hours",
      "buoy_source_age_hours",
